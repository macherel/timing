{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-i18n.mjs && vue-tsc -b && vite build",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "test": "vitest run && vue-tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-i18n": "11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "21.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
