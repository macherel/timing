{
  "name": "backend",
  "private": true,
  "description": "Pont local matériel vers WebUI",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/server.js",
    "diagnose": "tsx src/tools/diagnose.ts",
    "format": "prettier --write \"**/*.md\"",
    "test": "vitest run && tsc -p tsconfig.test.json",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "node-hid": "^3.4.0",
    "usb": "^2.19.1",
    "ws": "^8.22.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "prettier": "^3.9.10",
    "temporal-spec": "^1.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
